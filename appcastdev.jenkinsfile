pipeline {
  agent { label 'appcastdev' }
  options {
    authorizationMatrix([
      group(
        name: 'ONLYOFFICE',
        permissions: ['Job/Build', 'Job/Cancel', 'Job/Read', 'Job/Workspace']
      ),
      group(
        name: 'ASC-OFFICE',
        permissions: ['Job/Build', 'Job/Cancel', 'Job/Read', 'Job/Workspace']
      )
    ])
    disableConcurrentBuilds()
    skipDefaultCheckout true
  }
  parameters {
    string (
      name:         'build',
      description:  'Appcast build number for appcastdev.json (0 to delete)',
      defaultValue: ''
    )
  }
  stages {
    stage('Appcast') {
      steps {
        script {
          String version
          int build

          if (env.BRANCH_NAME ==~ /^(hotfix|release)\/.+/) {
            version = env.BRANCH_NAME.replaceAll(/.+\/v(?=[0-9.]+)/,'')
          } else if (env.BRANCH_NAME == 'develop') {
            version = '99.99.99'
          } else {
            error("bad version")
          }

          try {
            build = "${params.build}".toInteger()
          } catch (err) {
            error("bad build")
          }

          if (build > 0) {
            sh """
              APPCAST_PATH=windows/updates/appcastdev.json
              aws s3 cp --no-progress \
                s3://test-repo-r7/desktop/win/update/${version}/${build}/appcast.json \
                \${APPCAST_PATH##*/}
              lftp download.r7-office.ru -e "\\
                set ftp:ssl-protect-data true; \\
                set ftp:ssl-force true; \\
                set ssl:verify-certificate no; \\
                put -O \${APPCAST_PATH%/*} \${APPCAST_PATH##*/}; \\
                exit"
              echo "URL: https://download.r7-office.ru/\$APPCAST_PATH"
            """
          } else {
            sh """
              APPCAST_PATH=windows/updates/appcastdev.json
              lftp download.r7-office.ru -e "\\
                set ftp:ssl-protect-data true; \\
                set ftp:ssl-force true; \\
                set ssl:verify-certificate no; \\
                rm -f \${APPCAST_PATH}; \\
                exit"
              echo "URL: https://download.r7-office.ru/\$APPCAST_PATH"
            """
          }
        }
      }
    }
  }
}
